# Copy to .env and fill in. On Vercel these are set in Project Settings > Environment Variables.

# Postgres connection string. The Neon integration injects this automatically on Vercel;
# locally, run `vercel env pull .env` or paste the connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs admin auth cookies. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=

# S3 storage for image uploads. Leave S3_BUCKET empty to fall back to local disk in development.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Folder inside the bucket for CMS uploads, keeping them separate from existing images.
S3_MEDIA_PREFIX=cms

# Public base URL images are served from. Defaults to the CloudFront domain in app/data/consts.ts.
S3_PUBLIC_BASE_URL=
